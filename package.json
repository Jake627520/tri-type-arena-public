{
  "name": "tritype-arena",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:all": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "audit:licenses": "node scripts/license-audit.mjs && node --test tests/license-audit.test.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "validate:provenance": "node scripts/validate-vocabulary-provenance.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:vitest && npm run validate:provenance && npm run audit:licenses && npm run audit:security && npm run build",
    "build:release": "npm run validate:provenance && node scripts/check-vocabulary-release.mjs && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
